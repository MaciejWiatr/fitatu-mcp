# One-time bootstrap: take from https://www.fitatu.com after logging in:
#   localStorage.user.refresh_token  (128 hex chars)
#   localStorage.user.id
FITATU_REFRESH_TOKEN=
FITATU_USER_ID=

# Bearer token your agents send to this MCP server (Authorization: Bearer ...)
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Where to persist {accessToken, refreshToken, exp}
FITATU_STATE_PATH=./.fitatu-session.json

# HTTP port
PORT=3333
